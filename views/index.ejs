<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= portfolio.name %> | DevOps Engineer</title>

    <link rel="stylesheet" href="/css/style.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <div class="logo">
            BK
        </div>

        <ul>

            <li><a href="#home">Home</a></li>

            <li><a href="#about">About</a></li>

            <li><a href="#skills">Skills</a></li>

            <li><a href="#projects">Projects</a></li>

            <li><a href="#contact">Contact</a></li>

        </ul>

    </nav>

    <!-- ================= HERO ================= -->

    <section class="hero" id="home">

        <div class="hero-left">

            <p class="intro">
                Hello, I'm
            </p>

            <h1>
                <%= portfolio.name %>
            </h1>

            <h2>
                <%= portfolio.title %>
            </h2>

            <p class="tagline">
                <%= portfolio.tagline %>
            </p>

            <div class="hero-buttons">

                <a href="#projects" class="btn primary">

                    View Projects

                </a>

                <a href="/resume.pdf" class="btn secondary" download>

                    Download Resume

                </a>

            </div>

            <div class="tech-stack">

                <span>AWS</span>

                <span>DevOps</span>

                <span>SRE</span>

                <span>Linux</span>

                <span>Python</span>

                <span>ITIL</span>

            </div>

        </div>

        <div class="hero-right">

            <div class="profile-card">

                <img src="/images/photo.jpeg"
                     alt="Profile">

            </div>

        </div>

    </section>

    <!-- ================= ABOUT ================= -->

<section class="about" id="about">

    <div class="section-title">

        <h2>About Me</h2>

        <div class="underline"></div>

    </div>

    <div class="about-container">

        <div class="about-text">

            <p>
                <%= portfolio.about %>
            </p>

            <p>
                I specialize in Linux administration, cloud infrastructure,
                automation, CI/CD pipelines, and containerized application
                deployments. My goal is to build scalable, secure, and reliable
                infrastructure using modern DevOps practices.
            </p>

        </div>

        <div class="stats">

            <div class="stat-card">

                <h3>5+</h3>

                <p>Years Experience</p>

            </div>

            <div class="stat-card">

                <h3>20+</h3>

                <p>Technologies</p>

            </div>

            <div class="stat-card">

                <h3>25+</h3>

                <p>Automation Scripts</p>

            </div>

            <div class="stat-card">

                <h3>24/7</h3>

                <p>Production Support</p>

            </div>

        </div>

    </div>

</section>

<!-- ================= SKILLS ================= -->

<section class="skills" id="skills">

    <div class="section-title">

        <h2>Technical Skills</h2>

        <div class="underline"></div>

    </div>

    <div class="skills-grid">

        <div class="skill-card">
            <i class="fa-brands fa-aws"></i>
            <h3>AWS</h3>
        </div>

        <div class="skill-card">
            <i class="fa-brands fa-docker"></i>
            <h3>Docker</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-dharmachakra"></i>
            <h3>Kubernetes</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-server"></i>
            <h3>Linux</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-code-branch"></i>
            <h3>Jenkins</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-layer-group"></i>
            <h3>Terraform</h3>
        </div>

        <div class="skill-card">
            <i class="fa-brands fa-python"></i>
            <h3>Python</h3>
        </div>

        <div class="skill-card">
            <i class="fa-brands fa-git-alt"></i>
            <h3>Git</h3>
        </div>

        <div class="skill-card">
            <i class="fa-brands fa-github"></i>
            <h3>GitHub</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-chart-line"></i>
            <h3>Grafana</h3>
        </div>

        <div class="skill-card">
            <i class="fa-brands fa-microsoft"></i>
            <h3>Azure</h3>
        </div>

        <div class="skill-card">
            <i class="fa-brands fa-google"></i>
            <h3>GCP</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-chart-line"></i>
            <h3>Datadog</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-desktop"></i>
            <h3>Zenoss</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-arrow-right-arrow-left"></i>
            <h3>Signiant</h3>
        </div>

        <div class="skill-card">
            <i class="fa-solid fa-clipboard-check"></i>
            <h3>ITIL</h3>
        </div>

    </div>

</section>

<!-- ================= EXPERIENCE ================= -->

<section class="experience" id="experience">

    <div class="section-title">

        <h2>Professional Experience</h2>

        <div class="underline"></div>

    </div>

    <div class="timeline">

        <div class="timeline-item">

            <div class="timeline-dot"></div>

            <div class="timeline-content">

                <span class="timeline-year">Feb 2021 - Present</span>

                <h3>System Engineer</h3>

                <h4>Sutherland Global</h4>

                <p>
                    Supporting enterprise production environments with a focus on Linux administration,
                    incident management, cloud operations, infrastructure monitoring, and automation.
                    Worked with monitoring platforms, scripting, and deployment activities to ensure
                    high system availability and operational efficiency.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ================= PROJECTS ================= -->

<section class="projects" id="projects">

    <div class="section-title">

        <h2>Featured Projects</h2>

        <div class="underline"></div>

    </div>

    <div class="projects-grid">

        <% portfolio.projects.forEach(project => { %>

            <div class="project-card">

                <div class="project-top">

                    <i class="fa-solid fa-server"></i>

                </div>

                <h3><%= project.title %></h3>

                <p><%= project.description %></p>

                <div class="tech-list">

                    <% project.technologies.forEach(tech => { %>

                        <span><%= tech %></span>

                    <% }) %>

                </div>

                <div class="project-buttons">

                    <a href="<%= project.github %>">GitHub URL</a>

                </div>

            </div>

        <% }) %>

    </div>

</section>

<!-- ================= CONTACT ================= -->

<section class="contact" id="contact">

    <div class="section-title">
        <h2>Get In Touch</h2>
        <div class="underline"></div>
    </div>

    <div class="contact-container">

        <div class="contact-card">

            <i class="fa-solid fa-envelope"></i>
            <h3>Email</h3>
            <p>bhabajyotikalita66@gmail.com</p>

        </div>

        <div class="contact-card">

            <i class="fa-brands fa-linkedin"></i>
            <h3>LinkedIn</h3>
            <a href="https://www.linkedin.com/in/bhabajyotikalita/">linkedin.com/in/bhabajyotikalita/</a>

        </div>

        <div class="contact-card">

            <i class="fa-brands fa-github"></i>
            <h3>GitHub</h3>
            <a href="https://github.com/BhabajyotiKalita">github.com/BhabajyotiKalita</a>

        </div>

    </div>

</section>

</body>

</html>